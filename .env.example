# TutorReel 环境变量配置
# 复制本文件为 .env 并填入你的 key（.env 不会进 git，也不会打包进交付物）

# DeepSeek（讲解 LLM）—— 必填，用于把题目解析成讲解脚本
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com

# DashScope 通义千问（OCR 识别题目图片）—— 必填，用于识别题目图片中的文字与公式
# 获取: https://bailian.console.aliyun.com/  → API-KEY
DASHSCOPE_API_KEY=sk-your-dashscope-key
# OCR 视觉模型名（可按需换，如 qwen3.5-omni-plus）
OCR_MODEL=qwen-vl-max
# OCR API 地址（OpenAI 兼容格式）
OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# License: 逗号分隔的有效 Pro Key 列表（本地验证，无需外部服务器）
VALID_LICENSE_KEYS=PEX-XXXX-XXXX-XXXX,PEX-YYYY-YYYY-YYYY
